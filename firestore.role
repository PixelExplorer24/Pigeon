// Fast Messenger Pro — Firestore Security Rules
// Project used by the uploaded app: pigeon-7a637
// IMPORTANT: This app uses CLOUD FIRESTORE, not Realtime Database.
// Deploy this file in Firebase Console -> Firestore Database -> Rules.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // Same pair-id algorithm used by the app:
    // const pair=(a,b)=>[a,b].sort().join("__");
    function pairId(a, b) {
      return a < b ? a + "__" + b : b + "__" + a;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/artifacts/pigeon-7a637/public/data/users/$(uid);
    }

    function friendDoc(ownerUid, friendUid) {
      return /databases/$(database)/documents/artifacts/pigeon-7a637/public/data/friends/$(pairId(ownerUid, friendUid) + "__" + ownerUid);
    }

    function requestDoc(requestId) {
      return /databases/$(database)/documents/artifacts/pigeon-7a637/public/data/friendRequests/$(requestId);
    }

    function groupDoc(groupId) {
      return /databases/$(database)/documents/artifacts/pigeon-7a637/public/data/groups/$(groupId);
    }

    // ============================================================
    // USERS / PROFILES
    // ============================================================
    match /artifacts/pigeon-7a637/public/data/users/{uid} {
      // The app loads the complete user list for People/Search.
      allow read: if signedIn();

      // A user may create/update only his/her own profile.
      allow create: if signedIn()
        && uid == me()
        && request.resource.data.uid == me();

      allow update: if signedIn()
        && uid == me()
        && request.resource.data.uid == me();

      allow delete: if signedIn() && uid == me();
    }

    // ============================================================
    // FRIENDS
    // App creates TWO documents when a request is accepted:
    // pairId__receiver and pairId__sender.
    // ============================================================
    match /artifacts/pigeon-7a637/public/data/friends/{friendId} {
      allow read: if signedIn() && resource.data.ownerUid == me();

      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.friendUid != me()
        && request.resource.data.pairId == pairId(me(), request.resource.data.friendUid)
        && request.resource.data.requestId is string
        && getAfter(requestDoc(request.resource.data.requestId)).data.status == 'accepted'
        && (
          (
            getAfter(requestDoc(request.resource.data.requestId)).data.receiverUid == me()
            && getAfter(requestDoc(request.resource.data.requestId)).data.senderUid == request.resource.data.friendUid
          )
          ||
          (
            getAfter(requestDoc(request.resource.data.requestId)).data.senderUid == me()
            && getAfter(requestDoc(request.resource.data.requestId)).data.receiverUid == request.resource.data.friendUid
          )
        );

      allow update: if signedIn()
        && resource.data.ownerUid == me()
        && request.resource.data.ownerUid == me()
        && request.resource.data.friendUid == resource.data.friendUid
        && request.resource.data.pairId == resource.data.pairId;

      allow delete: if signedIn() && resource.data.ownerUid == me();
    }

    // ============================================================
    // FRIEND REQUESTS
    // ============================================================
    match /artifacts/pigeon-7a637/public/data/friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.senderUid == me() || resource.data.receiverUid == me());

      // New request: sender must be the authenticated user.
      allow create: if signedIn()
        && requestId == pairId(request.resource.data.senderUid, request.resource.data.receiverUid)
        && request.resource.data.pairId == pairId(request.resource.data.senderUid, request.resource.data.receiverUid)
        && request.resource.data.senderUid == me()
        && request.resource.data.receiverUid != me()
        && request.resource.data.status == 'pending';

      // Sender may resend a rejected request.
      // Receiver may accept/reject a pending request.
      allow update: if signedIn() && (
        (
          resource.data.senderUid == me()
          && resource.data.receiverUid != me()
          && resource.data.senderUid == request.resource.data.senderUid
          && resource.data.receiverUid == request.resource.data.receiverUid
          && request.resource.data.pairId == resource.data.pairId
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
        )
        ||
        (
          resource.data.receiverUid == me()
          && resource.data.senderUid == request.resource.data.senderUid
          && resource.data.receiverUid == request.resource.data.receiverUid
          && resource.data.status == 'pending'
          && (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected')
        )
      );

      allow delete: if signedIn()
        && (resource.data.senderUid == me() || resource.data.receiverUid == me());
    }

    // ============================================================
    // GROUPS
    // ============================================================
    match /artifacts/pigeon-7a637/public/data/groups/{groupId} {
      allow read: if signedIn()
        && resource.data.memberUids is list
        && me() in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids is list
        && me() in request.resource.data.memberUids;

      allow update: if signedIn()
        && resource.data.ownerUid == me()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids is list
        && me() in request.resource.data.memberUids;

      allow delete: if signedIn() && resource.data.ownerUid == me();
    }

    // ============================================================
    // MESSAGES
    // ============================================================
    match /artifacts/pigeon-7a637/public/data/messages/{messageId} {
      // Direct-message queries and group-message queries used by the app.
      allow read: if signedIn() && (
        resource.data.senderUid == me()
        || resource.data.receiverUid == me()
        || (resource.data.groupMemberUids is list && me() in resource.data.groupMemberUids)
      );

      // Create a direct message only between actual friends.
      allow create: if signedIn()
        && request.resource.data.senderUid == me()
        && request.resource.data.text is string
        && (
          // Direct chat
          (
            request.resource.data.receiverUid is string
            && request.resource.data.receiverUid != me()
            && get(friendDoc(me(), request.resource.data.receiverUid)).data.ownerUid == me()
            && get(friendDoc(me(), request.resource.data.receiverUid)).data.friendUid == request.resource.data.receiverUid
          )
          ||
          // Group chat
          (
            request.resource.data.groupId is string
            && request.resource.data.groupMemberUids is list
            && me() in request.resource.data.groupMemberUids
            && get(groupDoc(request.resource.data.groupId)).data.memberUids == request.resource.data.groupMemberUids
            && me() in get(groupDoc(request.resource.data.groupId)).data.memberUids
          )
        );

      // Message deletion:
      // - sender can delete their own message
      // - receiver can also delete a message from their own chat view
      // This is what allows the app's "delete message" feature to work for either side.
      allow delete: if signedIn()
        && (resource.data.senderUid == me() || resource.data.receiverUid == me());

      // Existing messages are not edited by the current app.
      // Keeping update restricted prevents changing sender/receiver/group ownership.
      allow update: if signedIn()
        && resource.data.senderUid == me()
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.receiverUid == resource.data.receiverUid
        && request.resource.data.groupId == resource.data.groupId;
    }

    // ============================================================
    // CALLS — Agora signalling documents
    // ============================================================
    match /artifacts/pigeon-7a637/public/data/calls/{callId} {
      // Caller and invited recipients can see the call document.
      allow read: if signedIn() && (
        resource.data.callerUid == me()
        || (resource.data.recipientUids is list && me() in resource.data.recipientUids)
      );

      // Start a call only as the authenticated caller.
      allow create: if signedIn()
        && request.resource.data.callerUid == me()
        && request.resource.data.recipientUids is list
        && request.resource.data.recipientUids.size() > 0
        && !(me() in request.resource.data.recipientUids)
        && request.resource.data.status == 'ringing'
        && (
          (
            request.resource.data.groupId == null
            && request.resource.data.recipientUids.size() == 1
            && get(friendDoc(me(), request.resource.data.recipientUids[0])).data.ownerUid == me()
            && get(friendDoc(me(), request.resource.data.recipientUids[0])).data.friendUid == request.resource.data.recipientUids[0]
          )
          ||
          (
            request.resource.data.groupId is string
            && get(groupDoc(request.resource.data.groupId)).data.memberUids is list
            && me() in get(groupDoc(request.resource.data.groupId)).data.memberUids
          )
        );

      // Caller can end/update participant state.
      // Recipient can accept/reject/end their invited call.
      allow update: if signedIn()
        && (
          resource.data.callerUid == me()
          || (resource.data.recipientUids is list && me() in resource.data.recipientUids)
        )
        // Signalling identity cannot be changed after the call is created.
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.recipientUids == resource.data.recipientUids
        && request.resource.data.callId == resource.data.callId
        && request.resource.data.channel == resource.data.channel;

      allow delete: if signedIn() && resource.data.callerUid == me();
    }

    // Default deny for everything else under Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
